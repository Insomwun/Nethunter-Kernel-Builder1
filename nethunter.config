name: "Build kernels"

env:
  CONFIGURATION: "repos.json"
  OUT_DIR: "out"
  NET_HUNTER_CONFIG: "nethunter.config"

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  Set-repos:
    name: "🐂 Parse repos.json"
    runs-on: ubuntu-latest

    outputs:
      repos: ${{ steps.generate-matrix.outputs.repos }}

    steps:
      - name: "😄 Checkout"
        uses: actions/checkout@v4

      - name: "✅ Validate repos.json"
        run: |
          jq empty "${CONFIGURATION}"
          jq -e 'type == "array" and length > 0' "${CONFIGURATION}" >/dev/null

      - name: "😆 Generate Matrix"
        id: generate-matrix
        shell: bash
        run: |
          {
            echo "repos<<EOF"
            cat "${CONFIGURATION}"
            echo "EOF"
          } >> "${GITHUB_OUTPUT}"

  Build-Kernel:
    name: "🐎 Build kernel"
    runs-on: ubuntu-latest
    needs: Set-repos

    strategy:
      max-parallel: 2
      fail-fast: false
      matrix:
        repos: ${{ fromJSON(needs.Set-repos.outputs.repos) }}

    env:
      kernelDir: ${{ matrix.repos.kernelSource.name }}_${{ matrix.repos.kernelSource.device }}
      kernelName: ${{ matrix.repos.kernelSource.name }}
      kernelRepo: ${{ matrix.repos.kernelSource.repo }}
      kernelBranch: ${{ matrix.repos.kernelSource.branch }}
      kernelDevice: ${{ matrix.repos.kernelSource.device }}
      DEFCONFIG_NAME: ${{ matrix.repos.kernelSource.device }}
      withKernelSU: ${{ matrix.repos.withKernelSU }}
      ARCH: ${{ matrix.repos.params.ARCH }}

    steps:
      - name: "✨ Create working directory"
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "${kernelDir}"

      - name: "⭐ Install prerequisites"
        shell: bash
        run: |
          set -euo pipefail
          sudo apt-get update
          sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
            bc \
            build-essential \
            bison \
            ccache \
            clang \
            curl \
            flex \
            ftp \
            gcc-aarch64-linux-gnu \
            gcc-arm-linux-gnueabi \
            git \
            libarchive-tools \
            libelf-dev \
            libfl-dev \
            libssl-dev \
            lftp \
            llvm \
            libncurses-dev \
            pkg-config \
            python3 \
            rsync \
            wget \
            zip \
            zstd

      - name: "🌟 Clone kernel source"
        working-directory: ./${{ env.kernelDir }}
        shell: bash
        run: |
          set -euo pipefail
          git clone \
            --recursive \
            --depth=1 \
            --branch "${kernelBranch}" \
            "${kernelRepo}" \
            "${kernelName}"

      - name: "💫 Get toolchains"
        working-directory: ./${{ env.kernelDir }}
        env:
          TOOLCHAINS: ${{ toJSON(matrix.repos.toolchains) }}
        shell: bash
        run: |
          set -euo pipefail
          toolchains_num="$(jq -r 'length' <<< "${TOOLCHAINS}")"

          for ((i = 0; i < toolchains_num; i++)); do
            name="$(jq -r ".[$i].name" <<< "${TOOLCHAINS}")"
            repo="$(jq -r ".[$i].repo" <<< "${TOOLCHAINS}")"
            branch="$(jq -r ".[$i].branch" <<< "${TOOLCHAINS}")"

            if [[ -z "${name}" || "${name}" == "null" ]]; then
              echo "Toolchain name is missing."
              exit 1
            fi

            if [[ -z "${repo}" || "${repo}" == "null" ]]; then
              echo "Toolchain repository is missing."
              exit 1
            fi

            git clone \
              --recursive \
              --depth=1 \
              --branch "${branch}" \
              "${repo}" \
              "${name}"

            toolchain_root="${PWD}/${name}"
            if [[ -d "${toolchain_root}/bin" ]]; then
              echo "${toolchain_root}/bin" >> "${GITHUB_PATH}"
            fi
            echo "${toolchain_root}" >> "${GITHUB_PATH}"
          done

      - name: "🔎 Check compiler toolchain"
        working-directory: ./${{ env.kernelDir }}/${{ env.kernelName }}
        env:
          PARAMS: ${{ toJSON(matrix.repos.params) }}
        shell: bash
        run: |
          set -euo pipefail
          cc="$(jq -r '.CC // ""' <<< "${PARAMS}")"
          cross_compile="$(jq -r '.CROSS_COMPILE // ""' <<< "${PARAMS}")"

          if [[ -n "${cc}" ]]; then
            command -v "${cc}" || {
              echo "Compiler '${cc}' was not found in PATH."
              exit 1
            }
          fi

          if [[ -n "${cross_compile}" ]]; then
            command -v "${cross_compile}gcc" || {
              echo "Cross compiler '${cross_compile}gcc' was not found in PATH."
              exit 1
            }
          fi

          echo "Compiler checks passed."
          echo "PATH=${PATH}"

      - name: "😎 Configure kernel"
        id: configure-kernel
        working-directory: ./${{ env.kernelDir }}/${{ env.kernelName }}
        env:
          PARAMS: ${{ toJSON(matrix.repos.params) }}
          EXTRA_PARAMS: ${{ toJSON(matrix.repos.extraParams) }}
        shell: bash
        run: |
          set -euo pipefail

          ARCH="$(jq -r '.ARCH // ""' <<< "${PARAMS}")"
          CROSS_COMPILE="$(jq -r '.CROSS_COMPILE // ""' <<< "${PARAMS}")"
          CC="$(jq -r '.CC // ""' <<< "${PARAMS}")"

          BUILD_OUT="${GITHUB_WORKSPACE}/${kernelDir}/${OUT_DIR}"
          mkdir -p "${BUILD_OUT}"

          if [[ -f "arch/arm64/configs/${DEFCONFIG_NAME}" ]]; then
            make O="${BUILD_OUT}" ARCH="${ARCH}" CROSS_COMPILE="${CROSS_COMPILE}" CC="${CC}" "${DEFCONFIG_NAME}"
          elif [[ -f "arch/arm64/configs/defconfig" ]]; then
            make O="${BUILD_OUT}" ARCH="${ARCH}" CROSS_COMPILE="${CROSS_COMPILE}" CC="${CC}" defconfig
          else
            make O="${BUILD_OUT}" ARCH="${ARCH}" CROSS_COMPILE="${CROSS_COMPILE}" CC="${CC}" olddefconfig
          fi

          if [[ -f "${GITHUB_WORKSPACE}/${NET_HUNTER_CONFIG}" ]]; then
            cp "${GITHUB_WORKSPACE}/${NET_HUNTER_CONFIG}" .config
            ./scripts/config --file .config --enable CONFIG_BT
            ./scripts/config --file .config --module CONFIG_BT_HCIBTUSB
            ./scripts/config --file .config --module CONFIG_BT_HCIBTSDIO
            ./scripts/config --file .config --module CONFIG_BT_HCIUART
            ./scripts/config --file .config --enable CONFIG_CFG80211
            ./scripts/config --file .config --enable CONFIG_MAC80211
            ./scripts/config --file .config --enable CONFIG_RFKILL
            ./scripts/config --file .config --module CONFIG_USB_USBNET
            ./scripts/config --file .config --module CONFIG_USB_NET_SMSC75XX
            ./scripts/config --file .config --module CONFIG_USB_NET_SMSC95XX
            ./scripts/config --file .config --module CONFIG_USB_SERIAL
            ./scripts/config --file .config --module CONFIG_USB_GADGET
            ./scripts/config --file .config --module CONFIG_USB_CONFIGFS
            ./scripts/config --file .config --module CONFIG_USB_CONFIGFS_F_FS
            ./scripts/config --file .config --module CONFIG_USB_F_HID
            make O="${BUILD_OUT}" ARCH="${ARCH}" CROSS_COMPILE="${CROSS_COMPILE}" CC="${CC}" olddefconfig
          fi

          echo "BUILD_OUT=${BUILD_OUT}" >> "${GITHUB_ENV}"

      - name: "🏗️ Build kernel"
        working-directory: ./${{ env.kernelDir }}/${{ env.kernelName }}
        shell: bash
        run: |
          set -euo pipefail
          make O="${BUILD_OUT}" \
            ARCH="${ARCH}" \
            CROSS_COMPILE="${CROSS_COMPILE}" \
            CC="${CC}" \
            -j"$(nproc --all)" \
            2>&1 | tee build.log

      - name: "📦 Upload build artifacts"
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ${{ env.kernelName }}-${{ env.kernelDevice }}-build
          path: |
            ${{ env.BUILD_OUT }}/arch/arm64/boot/Image*
            ${{ env.BUILD_OUT }}/arch/arm64/boot/dtb*
            ${{ env.BUILD_OUT }}/.config
            build.log
          if-no-files-found: warn

